# Stripe API Keys
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Product IDs (for feature plan mapping)
STRIPE_PRO_PRODUCT_ID=prod_...
STRIPE_ENTERPRISE_PRODUCT_ID=prod_...

# Stripe Price IDs
# Create products/prices at https://dashboard.stripe.com/products
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# App URL (for checkout redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Redis URL for multi-server cache
# REDIS_URL=redis://localhost:6379
